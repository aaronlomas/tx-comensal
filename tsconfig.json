{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "$lib/*": [
        "../taxorium/src/lib/*"
      ],
      "@tabler/icons-svelte": [
        "../taxorium/node_modules/@tabler/icons-svelte"
      ]
    }
  },
  "include": ["src/**/*", "manifest.json"]
}
